# DeepSeek 官方
DEEPSEEK_API_KEY=<从对应平台获取>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 百炼 (阿里云 Model Studio) — OpenAI 兼容端点，同样跑 deepseek-v4-flash
DASHSCOPE_API_KEY=<从对应平台获取>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Gemini on Vertex AI — 认证走 ADC (gcloud auth application-default login)，无 API key
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=<你的 GCP 项目 ID>
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
