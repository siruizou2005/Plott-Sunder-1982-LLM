# DeepSeek 官方
DEEPSEEK_API_KEY=<从对应平台获取>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 百炼 (阿里云 Model Studio) — OpenAI 兼容端点，同样跑 deepseek-v4-flash
DASHSCOPE_API_KEY=<从对应平台获取>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Gemini on Vertex AI — 认证走 ADC (gcloud auth application-default login)，无 API key
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=<你的 GCP 项目 ID>
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# 可选：当本目录没有 .env 时，回退到另一个项目的 .env（适合多项目共用同一个 API 账号）。
# 不设置就没有回退。
# PS1982_FALLBACK_ENV=/path/to/another/project/.env
